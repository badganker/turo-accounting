# Claude API key, used to read receipt images (vendor/amount/date/category extraction)
ANTHROPIC_API_KEY=sk-ant-...

# 32-byte key (base64) used to encrypt the saved Turo login session at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Password to log into this app. Required once it's reachable outside your
# own machine. Pick something strong — it's compared directly, not hashed.
APP_PASSWORD=

# Secret used to sign login session cookies. Generate one the same way as
# SESSION_ENCRYPTION_KEY above (use a different value).
AUTH_SECRET=

PORT=4100
NODE_ENV=development
